# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# -- Core API Keys --
PINECONE_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=            # only needed if Agent_llm or Embeddings_model is OPENAI

# -- Embeddings --
Embeddings_model=LOCAL       # "OPENAI" (1536-dim) or "LOCAL" (1024-dim)
Local_Embedding_Model=BAAI/bge-m3

# -- LangGraph Orchestration Layer --
Agent_llm=DEEPSEEK           # "OPENAI" | "DEEPSEEK" | anything else -> local Ollama

# -- SQL: admin identity (ingestion + audit log viewer) --
# Must match MSSQL_SA_PASSWORD from the docker run command.
SQL_ADMIN_USERNAME=sa
SQL_ADMIN_PASSWORD=

# -- SQL: restricted identity the agent runs as --
# Must match the login created in scripts/setup_security_and_view.sql.
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=

# -- SQL: connection --
SQL_SERVER_HOST=localhost    # or the EC2 public IP
SQL_SERVER_PORT=1433
